# Configuração do painel no Docker. Copie para .env e ajuste:
#   cp .env.example .env
# O .env fica fora do git (contém a senha).

# Senha do painel. Vazia, o painel fica aberto a quem estiver na rede.
DROID_PANEL_PASSWORD=troque-esta-senha

# Porta do painel (os Nodes e o navegador acessam http://<ip-do-host>:PORTA).
DROID_PORT=5050
